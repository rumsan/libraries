{
  "name": "@rumsan/user",
  "version": "3.0.170-rc.12",
  "description": "Rumsan user management library",
  "author": "rumsan.com",
  "license": "AGPL-3.0",
  "licenses": [
    {
      "type": "AGPL-3.0",
      "url": "https://opensource.org/licenses/AGPL-3.0"
    },
    {
      "type": "Commercial License",
      "url": "https://www.rumsan.com"
    }
  ],
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./ability/ms-rpc-auth": {
      "types": "./lib/ability/ms-rpc-auth/index.d.ts",
      "default": "./lib/ability/ms-rpc-auth/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./*.d.ts",
      "default": "./*.js"
    }
  },
  "typesVersions": {
    "*": {
      "ability/ms-rpc-auth": [
        "./lib/ability/ms-rpc-auth/index.d.ts"
      ],
      "*": [
        "./*"
      ]
    }
  }
}
